#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;

        // zmk,physical-layout = &foostan_corne_5col_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB                &kp Q  &kp W  &kp E  &kp R      &kp T      &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&mt LEFT_WIN CAPSLOCK  &kp A  &kp S  &kp D  &kp F      &kp G      &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT              &kp Z  &kp X  &kp C  &kp V      &kp B      &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                     &mo 1  &kp RCTRL  &kp SPACE  &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            bindings = <
&kp ESCAPE        &kp N1    &kp N2          &kp N3     &kp N4             &kp N5           &kp N6          &kp N7    &kp N8    &kp N9     &kp N0      &kp BSPC
&kp C_PLAY_PAUSE  &trans    &kp UP_ARROW    &kp END    &kp C_VOL_UP       &kp C_MUTE       &bt BT_NXT      &trans    &kp UP    &kp END    &kp HOME    &kp PAGE_UP
&kp LSHFT         &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp C_VOLUME_DOWN  &kp PRINTSCREEN  &bt BT_CLR_ALL  &kp LEFT  &kp DOWN  &kp RIGHT  &kp INSERT  &kp PAGE_DOWN
                                            &kp LGUI   &trans             &kp SPACE        &kp RET         &trans    &kp RALT
            >;
        };

        raise_layer {
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS   &kp ASTRK         &kp LPAR  &kp RPAR   &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans     &kp MINUS  &kp EQUAL  &kp LBKT          &kp RBKT  &kp BSLH   &kp PIPE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans     &kp UNDER  &kp PLUS   &kp LBRC          &kp RBRC  &kp GRAVE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE  &kp RET    &trans     &kp LS(LEFT_ALT)
            >;
        };
    };
};
